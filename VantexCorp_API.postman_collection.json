								"exec": [
									"pm.test(\"Status code es 201 Created o 200\", function () {\r",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
									"});\r",
									"\r",
									"pm.test(\"La máquina se ha creado correctamente\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    var inspectData = jsonData.data ? jsonData.data : jsonData;\r",
									"    var enviadoEnBody = JSON.parse(pm.request.body.raw);\r",
									"    \r",
									"    pm.expect(inspectData.asset_code).to.eql(enviadoEnBody.asset_code);\r",
									"    \r",
									"    if (inspectData.id) {\r",
									"        pm.collectionVariables.set(\"machineId\", inspectData.id);\r",
